"use client";

import { useState } from "react";
import { auth } from "@/lib/firebase";

type DuplicateQuestion = {
  questionId: string;
  questionText: string;
  bookId: string;
  chapterId: string;
  masterSource: string;
  importSource: string;
};

type DuplicateGroup = {
  fingerprint: string;
  questionIds: string[];
  count: number;
  questions?: DuplicateQuestion[];
};

type AuditResult = {
  success: boolean;
  readOnly?: boolean;

  summary?: {
    totalQuestions: number;
    totalFingerprintIndexes: number;
    indexedQuestions: number;
    missingFingerprint: number;
    duplicateGroups: number;
    conflictingIndexes: number;
    emptyQuestions: number;
  };

  duplicateGroups?: DuplicateGroup[];

  missingFingerprint?: string[];

  conflictingIndexes?: {
    fingerprint: string;
    indexedQuestionId: string;
    actualQuestionIds: string[];
  }[];

  emptyQuestions?: string[];

  error?: string;
};

export default function QuestionUniquenessAuditPage() {
  const [result, setResult] =
    useState<AuditResult | null>(null);

  const [loading, setLoading] =
    useState(false);

  const [error, setError] =
    useState("");

  async function runAudit() {
    try {
      setLoading(true);
      setError("");

      const user = auth.currentUser;

      if (!user) {
        throw new Error(
          "You are not logged in. Please login again."
        );
      }

      const token =
        await user.getIdToken();

      const response =
        await fetch(
          "/api/admin/questions/audit",
          {
            method: "GET",
            headers: {
              Authorization:
                `Bearer ${token}`,
            },
          }
        );

      const data =
        await response.json();

      if (
        !response.ok ||
        !data.success
      ) {
        throw new Error(
          data.error ||
            "Unable to run Question Bank audit."
        );
      }

      setResult(data);

    } catch (err: any) {

      console.error(
        "Question uniqueness audit error:",
        err
      );

      setError(
        err?.message ||
          "Unable to run audit."
      );

    } finally {
      setLoading(false);
    }
  }

  return (
    <main className="min-h-screen bg-slate-50 p-6">

      <div className="mx-auto max-w-7xl">

        <div className="mb-8">

          <div className="mb-2 text-sm font-bold uppercase tracking-wide text-indigo-600">
            Question Bank Administration
          </div>

          <h1 className="text-3xl font-extrabold text-[#123b78]">
            Question Uniqueness Audit
          </h1>

          <p className="mt-2 max-w-4xl text-sm leading-6 text-slate-600">
            Read-only audit of the master Question Bank.
            This page does not create, modify, merge or
            delete any question.
          </p>

        </div>


        <div className="mb-8 rounded-2xl border border-amber-200 bg-amber-50 p-5">

          <div className="font-extrabold text-amber-900">
            READ-ONLY AUDIT
          </div>

          <p className="mt-1 text-sm leading-6 text-amber-800">
            Existing Question Bank documents and
            Practice Set references will not be changed
            by this audit.
          </p>

        </div>


        <div className="mb-8">

          <button
            type="button"
            onClick={runAudit}
            disabled={loading}
            className="rounded-xl bg-[#123b78] px-6 py-3 font-bold text-white shadow-sm transition hover:bg-[#0e2f63] disabled:cursor-not-allowed disabled:opacity-50"
          >
            {loading
              ? "Running Audit..."
              : "Run Question Bank Audit"}
          </button>

        </div>


        {error && (

          <div className="mb-8 rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-700">
            {error}
          </div>

        )}


        {result?.summary && (

          <>

            <div className="mb-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">

              <SummaryCard
                title="Total Questions"
                value={
                  result.summary.totalQuestions
                }
              />

              <SummaryCard
                title="Fingerprint Indexes"
                value={
                  result.summary
                    .totalFingerprintIndexes
                }
              />

              <SummaryCard
                title="Indexed Questions"
                value={
                  result.summary.indexedQuestions
                }
              />

              <SummaryCard
                title="Missing Fingerprint"
                value={
                  result.summary
                    .missingFingerprint
                }
                warning={
                  result.summary
                    .missingFingerprint > 0
                }
              />

              <SummaryCard
                title="Duplicate Groups"
                value={
                  result.summary
                    .duplicateGroups
                }
                warning={
                  result.summary
                    .duplicateGroups > 0
                }
              />

              <SummaryCard
                title="Conflicting Indexes"
                value={
                  result.summary
                    .conflictingIndexes
                }
                warning={
                  result.summary
                    .conflictingIndexes > 0
                }
              />

              <SummaryCard
                title="Empty Questions"
                value={
                  result.summary
                    .emptyQuestions
                }
                warning={
                  result.summary
                    .emptyQuestions > 0
                }
              />

            </div>


            <section className="mb-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">

              <h2 className="text-xl font-extrabold text-[#123b78]">
                Duplicate Question Groups
              </h2>

              <p className="mt-1 text-sm text-slate-500">
                Questions with identical normalized
                question text.
              </p>


              {!result.duplicateGroups?.length ? (

                <div className="mt-5 rounded-xl bg-emerald-50 p-4 text-sm font-semibold text-emerald-700">
                  No duplicate groups detected.
                </div>

              ) : (

                <div className="mt-5 space-y-4">

                  {result.duplicateGroups.map(
                    (group, index) => (

                      <details
                        key={group.fingerprint}
                        className="rounded-xl border border-red-200 bg-red-50"
                      >

                        <summary className="cursor-pointer p-4 font-bold text-red-800">

                          Duplicate Group #
                          {index + 1}

                          <span className="ml-3 rounded-full bg-red-100 px-2 py-1 text-xs">
                            {group.count} questions
                          </span>

                        </summary>

                        <div className="border-t border-red-200 p-4">

                          <div className="mb-3 break-all font-mono text-xs text-slate-500">
                            Fingerprint:
                            {" "}
                            {group.fingerprint}
                          </div>

                          <div className="space-y-2">

                            {group.questionIds.map(
                              (questionId) => (

                                <div
                                  key={questionId}
                                  className="rounded-lg bg-white px-4 py-3 font-mono text-sm font-semibold text-slate-700"
                                >
                                  {questionId}
                                </div>

                              )
                            )}

                          </div>

                        </div>

                      </details>

                    )
                  )}

                </div>

              )}

            </section>


            <section className="mb-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">

              <h2 className="text-xl font-extrabold text-[#123b78]">
                Questions Missing Fingerprint Index
              </h2>

              <p className="mt-1 text-sm text-slate-500">
                These existing questions have no entry
                yet in the uniqueness index.
              </p>


              {!result.missingFingerprint?.length ? (

                <div className="mt-5 rounded-xl bg-emerald-50 p-4 text-sm font-semibold text-emerald-700">
                  All questions have a fingerprint index.
                </div>

              ) : (

                <div className="mt-5 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">

                  {result.missingFingerprint.map(
                    (questionId) => (

                      <div
                        key={questionId}
                        className="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-semibold text-slate-700"
                      >
                        {questionId}
                      </div>

                    )
                  )}

                </div>

              )}

            </section>


            <section className="mb-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">

              <h2 className="text-xl font-extrabold text-[#123b78]">
                Conflicting Fingerprint Indexes
              </h2>


              {!result.conflictingIndexes?.length ? (

                <div className="mt-5 rounded-xl bg-emerald-50 p-4 text-sm font-semibold text-emerald-700">
                  No conflicting fingerprint indexes detected.
                </div>

              ) : (

                <div className="mt-5 space-y-4">

                  {result.conflictingIndexes.map(
                    (item) => (

                      <div
                        key={item.fingerprint}
                        className="rounded-xl border border-red-200 bg-red-50 p-4"
                      >

                        <div className="font-bold text-red-800">
                          Indexed Question:
                          {" "}
                          <span className="font-mono">
                            {item.indexedQuestionId}
                          </span>
                        </div>

                        <div className="mt-2 break-all font-mono text-xs text-slate-500">
                          {item.fingerprint}
                        </div>

                        <div className="mt-3 text-sm font-semibold text-slate-700">
                          Actual matching questions:
                        </div>

                        <div className="mt-2 flex flex-wrap gap-2">

                          {item.actualQuestionIds.map(
                            (id) => (

                              <span
                                key={id}
                                className="rounded-lg bg-white px-3 py-2 font-mono text-xs font-semibold"
                              >
                                {id}
                              </span>

                            )
                          )}

                        </div>

                      </div>

                    )
                  )}

                </div>

              )}

            </section>


            <section className="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">

              <h2 className="text-xl font-extrabold text-[#123b78]">
                Empty / Invalid Questions
              </h2>


              {!result.emptyQuestions?.length ? (

                <div className="mt-5 rounded-xl bg-emerald-50 p-4 text-sm font-semibold text-emerald-700">
                  No empty question documents detected.
                </div>

              ) : (

                <div className="mt-5 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">

                  {result.emptyQuestions.map(
                    (questionId) => (

                      <div
                        key={questionId}
                        className="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm font-semibold"
                      >
                        {questionId}
                      </div>

                    )
                  )}

                </div>

              )}

            </section>

          </>

        )}

      </div>

    </main>
  );
}


/* =====================================================
   SUMMARY CARD
===================================================== */

function SummaryCard({
  title,
  value,
  warning = false,
}: {
  title: string;
  value: number;
  warning?: boolean;
}) {

  return (

    <div
      className={
        "rounded-2xl border bg-white p-5 shadow-sm " +
        (
          warning
            ? "border-amber-300"
            : "border-slate-200"
        )
      }
    >

      <div className="text-sm font-semibold text-slate-500">
        {title}
      </div>

      <div
        className={
          "mt-2 text-3xl font-extrabold " +
          (
            warning
              ? "text-amber-600"
              : "text-[#123b78]"
          )
        }
      >
        {value}
      </div>

    </div>

  );
}

